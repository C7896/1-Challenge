# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase Admin SDK service account keys - never commit these
*-firebase-adminsdk-*.json
service-account*.json

# local env files
.env*.local

# typescript
*.tsbuildinfo

# native folders are generated by expo prebuild / EAS (CNG)
/ios
/android
